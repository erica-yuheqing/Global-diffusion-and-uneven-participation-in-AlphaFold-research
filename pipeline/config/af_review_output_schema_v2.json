{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/af-review-output-v2.json",
  "title": "AlphaFold independent review output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "work_id",
    "primary_label",
    "relevance_level",
    "evidence_level",
    "af_related_label",
    "af_use_label",
    "adoption_eligible",
    "observed_actions",
    "future_or_hypothetical_only",
    "confidence",
    "needs_human_review",
    "human_review_reasons",
    "exclusion_reason",
    "evidence",
    "reasoning_summary",
    "action_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "af-model-review-output-v2"
    },
    "review_id": {
      "type": "string",
      "pattern": "^(?:P[0-9]{3}|W[0-9]+)$"
    },
    "work_id": {
      "type": "string",
      "pattern": "^W[0-9]+$"
    },
    "primary_label": {
      "enum": [
        "FP",
        "background_only",
        "review_discussion",
        "database_consumption",
        "model_application",
        "method_development",
        "original_platform",
        "uncertain"
      ]
    },
    "relevance_level": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "RU"
      ]
    },
    "evidence_level": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3"
      ]
    },
    "af_related_label": {
      "enum": [
        "false",
        "background",
        "related",
        "uncertain"
      ]
    },
    "af_use_label": {
      "enum": [
        "no",
        "yes",
        "uncertain"
      ]
    },
    "adoption_eligible": {
      "enum": [
        "no",
        "yes",
        "uncertain"
      ]
    },
    "observed_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "retrieved_precomputed_structure",
          "ran_alphafold",
          "ran_colabfold",
          "integrated_empirical_workflow",
          "docking_or_screening",
          "benchmarked_or_evaluated",
          "modified_or_extended",
          "developed_downstream_tool",
          "discussion_only",
          "none"
        ]
      }
    },
    "future_or_hypothetical_only": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_human_review": {
      "type": "boolean"
    },
    "human_review_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "abstract_only",
          "insufficient_evidence",
          "boundary_R2_R3",
          "boundary_R3_R4",
          "original_vs_downstream",
          "conflicting_evidence",
          "citation_link_uncertain",
          "low_confidence",
          "other",
          "prediction_origin_unclear",
          "input_quality"
        ]
      }
    },
    "exclusion_reason": {
      "enum": [
        "none",
        "unrelated_or_abbreviation",
        "background_only",
        "review_no_use",
        "original_platform",
        "insufficient_evidence",
        "future_hypothetical_only",
        "other"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_kind",
          "block_index",
          "section",
          "quote",
          "supports"
        ],
        "properties": {
          "source_kind": {
            "enum": [
              "title",
              "abstract",
              "fulltext_block",
              "matched_reference"
            ]
          },
          "block_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "relation",
                "use",
                "engagement",
                "exclusion",
                "uncertainty"
              ]
            }
          }
        }
      }
    },
    "reasoning_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "action_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "evidence_indices"
        ],
        "properties": {
          "action": {
            "enum": [
              "retrieved_precomputed_structure",
              "ran_alphafold",
              "ran_colabfold",
              "integrated_empirical_workflow",
              "docking_or_screening",
              "benchmarked_or_evaluated",
              "modified_or_extended",
              "developed_downstream_tool",
              "discussion_only"
            ]
          },
          "evidence_indices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          }
        }
      }
    }
  }
}
